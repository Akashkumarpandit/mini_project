# Frontend Environment Variables Template
# Copy this file to .env or .env.local to customize your configuration

# API Base URL (defaults to Vite's proxy path /api which proxies to http://localhost:8080)
# When deploying separately or connecting directly, set: http://localhost:8080/api
VITE_API_URL=/api

# Mapbox / Google Maps API Key (Optional fallback gracefully handled if omitted)
# VITE_MAPS_API_KEY=your_maps_api_key_here
