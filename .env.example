# =================================================================
# FULL-STACK PROPERTY RENTAL MARKETPLACE ENVIRONMENT CONFIGURATION
# =================================================================
# Copy this file to .env before starting the services if customizing values.

# ── Backend Configuration (Spring Boot) ──────────────────────────
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# ── Database Configuration ───────────────────────────────────────
# Default: in-memory H2 (active when SPRING_PROFILES_ACTIVE=dev)
# For MySQL persistence (activate with SPRING_PROFILES_ACTIVE=mysql):
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=authdb
MYSQL_USER=root
MYSQL_PASSWORD=root

# ── Security & JWT ───────────────────────────────────────────────
# Strong Base64-encoded 256-bit secret (replace in production!)
APP_JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
APP_JWT_EXPIRATION_MS=86400000

# ── Google OAuth2 Credentials (Optional) ─────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret-here

# ── Frontend Configuration (React / Vite) ────────────────────────
VITE_PORT=5173
VITE_API_URL=/api
